rules_version = '2';

service firebase.storage {
  match /b/{bucket}/o {
    match /{allPaths=**} {
      // Public read access for portfolio images/pdfs.
      allow read: if true;
      // Only authenticated admin can upload/delete files, with size (15MB) and MIME validation.
      allow write: if request.auth != null && (
        request.resource == null || (
          request.resource.size < 15 * 1024 * 1024 &&
          request.resource.contentType.matches('image/.*|video/.*|application/pdf')
        )
      );
    }
  }
}
